    "claude",
    "claude-code",
    "gui",
    "electron",
    "ai",
    "terminal"
  ],
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "misans": "^4.1.0",
    "qrcode": "^1.5.4"
  }
}
